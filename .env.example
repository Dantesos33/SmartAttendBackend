# MySQL connection
DATABASE_URL=mysql+pymysql://root:@localhost:3306/smartattend_db


# JWT
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# The separate face-recognition microservice (already built, kept independent)
RECOGNITION_SERVICE_URL=http://localhost:8000

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=*
ENVIRONMENT=development
